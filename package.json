{
  "name": "tx402-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for tx402 \u2014 resilient x402 buyer SDK. Not published.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --filter \"!tx402-docs\" -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter \"!tx402-docs\" -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node tools/size-gate/index.js",
    "conformance:build": "node tools/conformance/index.js build",
    "conformance:check": "node tools/conformance/index.js check",
    "manifest:verify": "node tools/manifest-signer/index.js verify",
    "docs:generate": "pnpm --filter tx402 build && node tools/docs-gen/index.js build",
    "docs:check": "node tools/docs-gen/index.js check",
    "docs:dev": "pnpm --filter tx402-docs dev",
    "docs:build": "pnpm --filter tx402-docs build",
    "nul-check": "node tools/nul-check/index.js",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm nul-check && pnpm workflow-lint && pnpm conformance:check && pnpm manifest:verify && pnpm test && pnpm build && pnpm size && pnpm docs:check && pnpm docs:build",
    "workflow-lint": "node tools/workflow-lint/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
